{
  "name": "signbridge",
  "version": "1.0.0",
  "description": "SignBridge – Speech Becomes Sign. Echtzeit-Übersetzer gesprochener Sprache in DGS-Gebärden. Angular-Frontend über der Logik-Engine B0–B5.",
  "private": true,
  "scripts": {
    "preinstall": "npm config set strict-ssl false",
    "install:legacy": "npm install --legacy-peer-deps --strict-ssl=false",
    "start": "set NODE_OPTIONS=--openssl-legacy-provider && ng serve",
    "build": "set NODE_OPTIONS=--openssl-legacy-provider && ng build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "generate:assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "animejs": "^3.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@types/animejs": "^3.1.12",
    "typescript": "~5.4.2",
    "vitest": "^2.1.8"
  }
}
